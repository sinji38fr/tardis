# URL utilisée dans les liens. Un sous-chemin est possible : https://tochiro/tardis
TARDIS_PUBLIC_URL=http://localhost:8088
# 127.0.0.1 = accès depuis Tochiro seulement ; adresse LAN pour accès réseau.
TARDIS_BIND_ADDRESS=127.0.0.1
TARDIS_PORT=8088
TARDIS_DATABASE_BACKUP_INTERVAL=3600
TARDIS_DATABASE_BACKUP_KEEP=30
TARDIS_IMAGE=shinji38fr/tardis:1.0.0
# Notifications optionnelles : laisser vide pour désactiver.
TARDIS_WEBHOOK_URL=
TARDIS_WEBHOOK_SECRET=
# Chemins hôte ; volumes créés par Docker par défaut dans compose.yaml.
